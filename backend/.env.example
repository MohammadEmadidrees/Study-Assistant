# Server configuration
PROJECT_NAME="Study Assistant AI Chatbot"
ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:3000"]

# Database configuration (PostgreSQL async)
# Default is PostgreSQL. Aiosqlite fallback is supported for local environments: sqlite+aiosqlite:///./study_assistant.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot_db

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# LLM Provider configuration
DEFAULT_LLM_PROVIDER="claude"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
LLM_TIMEOUT_SECONDS=60.0

# Rate Limiting & Safety
RATE_LIMIT_PER_MINUTE=20
MAX_HISTORY_MESSAGES=10
